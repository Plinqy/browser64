{
  "name": "c64-browser-emulator",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "A from-scratch Commodore 64 emulator for the browser with an NMOS 6510 core, stock C64 memory banking, and functional MOS 6526 CIA chips.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/ui": "^4.1.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
