{
  "name": "c64-browser-emulator",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "From-scratch browser Commodore 64 emulator \u2014 cycle-stepped 6510/VIC-II/CIA/SID core with ROM, input, PRG and AudioWorklet support",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@vitest/ui": "^4.1.10",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
